#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

mode="${1:-}"
theme_dir="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/themes"

case "$mode" in
	light | dark) ;;
	*)
		echo "usage: ${0##*/} light|dark" >&2
		exit 2
		;;
esac

theme_file="$theme_dir/$mode.conf"
if [[ ! -r "$theme_file" ]]; then
	echo "tmux theme is not readable: $theme_file" >&2
	exit 1
fi

tmux source-file "$theme_file"
tmux refresh-client -S

# Codex caches the terminal's OSC 10/11 colors. Send its focus-gained event
# directly to each Codex pane after tmux's pane colors have been updated.
while IFS=$'\t' read -r pane_id pane_command; do
	if [[ "$pane_command" == codex* ]]; then
		tmux send-keys -l -t "$pane_id" $'\033[I'
	fi
done < <(tmux list-panes -a -F '#{pane_id}	#{pane_current_command}')
